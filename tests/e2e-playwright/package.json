{
  "name": "wedevs_pm_automation",
  "version": "1.0.0",
  "description": "End-to-end tests for weDevs Project Manager (Free)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "CI=false pnpm exec playwright test --headed",
    "test:ci": "pnpm exec playwright test",
    "install:browsers": "pnpm exec playwright install chromium",
    "merge-reports": "pnpm exec playwright merge-reports --reporter=html ./blob-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "wordpress",
    "wedevs",
    "project-manager",
    "pm"
  ],
  "author": "weDevs QA",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.57.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@wordpress/env": "^10.36.0",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.3.1"
  }
}
